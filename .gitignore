# ── Secrets: never commit. Backed by .pre-commit-config.yaml (gitleaks) and
#    .github/workflows/secret-scan.yml.
.env
.env.*
!.env.example
*.local.json
*.local.toml
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision

# ── Local-only agent state (committed guidance lives in .github/skills and AGENTS.md)
.claude/
.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json
.codex/
.github/aw/logs/

