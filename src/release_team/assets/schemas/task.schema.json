{
  "$defs": {
    "Action": {
      "enum": [
        "analyze",
        "draft",
        "plan",
        "publish"
      ],
      "title": "Action",
      "type": "string"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "media_type": {
          "default": "text/markdown",
          "title": "Media Type",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "name",
        "content"
      ],
      "title": "Artifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "workflow_id": {
      "format": "uuid",
      "title": "Workflow Id",
      "type": "string"
    },
    "source": {
      "default": "user",
      "title": "Source",
      "type": "string"
    },
    "agent": {
      "minLength": 1,
      "title": "Agent",
      "type": "string"
    },
    "action": {
      "$ref": "#/$defs/Action"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "requirements": {
      "items": {
        "type": "string"
      },
      "title": "Requirements",
      "type": "array"
    },
    "destination": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination"
    },
    "content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content"
    }
  },
  "required": [
    "agent",
    "action",
    "objective"
  ],
  "title": "Task",
  "type": "object"
}
