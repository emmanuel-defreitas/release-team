{
  "$defs": {
    "Action": {
      "enum": [
        "analyze",
        "draft",
        "plan",
        "publish"
      ],
      "title": "Action",
      "type": "string"
    },
    "AgentBody": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "instructions": {
          "title": "Instructions",
          "type": "string"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "title": "Actions",
          "type": "array"
        },
        "runtime": {
          "default": "provider-neutral",
          "title": "Runtime",
          "type": "string"
        },
        "input_contract": {
          "const": "task.schema.json",
          "default": "task.schema.json",
          "title": "Input Contract",
          "type": "string"
        },
        "output_contract": {
          "const": "result.schema.json",
          "default": "result.schema.json",
          "title": "Output Contract",
          "type": "string"
        },
        "permissions": {
          "$ref": "#/$defs/Permissions"
        }
      },
      "required": [
        "role",
        "instructions",
        "skills",
        "actions"
      ],
      "title": "AgentBody",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Permissions": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "default": "read",
          "enum": [
            "read",
            "none"
          ],
          "title": "Repository",
          "type": "string"
        },
        "artifacts": {
          "const": "draft",
          "default": "draft",
          "title": "Artifacts",
          "type": "string"
        },
        "public_publish": {
          "const": false,
          "default": false,
          "title": "Public Publish",
          "type": "boolean"
        }
      },
      "title": "Permissions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "release-team.dev/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "Agent",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/AgentBody"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "AgentSpec",
  "type": "object"
}
